<?php
require_once 'config.php';

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    header('Location: index.php'); exit;
}

// mapping + sanitasi sederhana
$nama_sepatu = trim($_POST['nama_sepatu'] ?? '');
$merk = trim($_POST['merk'] ?? '');
$kategori = trim($_POST['kategori'] ?? '');
$ukuran = trim($_POST['ukuran'] ?? '');
$warna = trim($_POST['warna'] ?? '');
$harga = $_POST['harga'] ?? 0;
$stok  = $_POST['stok'] ?? 0;
$deskripsi = trim($_POST['deskripsi'] ?? '');

// validasi singkat
if ($nama_sepatu === '' || $merk === '' || $kategori === '' || $ukuran === '' || $warna === '' || !is_numeric($harga) || !is_numeric($stok)) {
    header("Location: index.php?error=" . urlencode("Semua field wajib diisi dan harga/stok harus angka."));
    exit;
}

// upload gambar
$uploadDir = __DIR__ . '/uploads/';
if (!is_dir($uploadDir)) mkdir($uploadDir, 0755, true);
$gambarFile = 'default.jpg';
if (!empty($_FILES['gambar']['name']) && $_FILES['gambar']['error'] == UPLOAD_ERR_OK) {
    $tmp = $_FILES['gambar']['tmp_name'];
    $orig = basename($_FILES['gambar']['name']);
    $ext = pathinfo($orig, PATHINFO_EXTENSION);
    $safe = preg_replace('/[^A-Za-z0-9_\-]/', '_', pathinfo($orig, PATHINFO_FILENAME));
    $gambarFile = time() . '_' . $safe . '.' . $ext;
    if (!move_uploaded_file($tmp, $uploadDir . $gambarFile)) {
        header("Location: index.php?error=" . urlencode("Gagal menyimpan gambar."));
        exit;
    }
}

try {
    $sql = "INSERT INTO sepatu (nama_sepatu, merk, kategori, ukuran, warna, harga, stok, deskripsi, gambar)
            VALUES (:nama, :merk, :kategori, :ukuran, :warna, :harga, :stok, :deskripsi, :gambar)";
    $stmt = $pdo->prepare($sql);
    $stmt->execute([
        ':nama' => $nama_sepatu,
        ':merk' => $merk,
        ':kategori' => $kategori,
        ':ukuran' => $ukuran,
        ':warna' => $warna,
        ':harga' => $harga,
        ':stok' => $stok,
        ':deskripsi' => $deskripsi,
        ':gambar' => $gambarFile
    ]);
    header("Location: index.php?message=" . urlencode("Produk berhasil ditambahkan"));
    exit;
} catch (PDOException $e) {
    header("Location: index.php?error=" . urlencode("SQL Error: " . $e->getMessage()));
    exit;
}
?>
